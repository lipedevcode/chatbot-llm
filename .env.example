# PostgreSQL credentials
CHATBOT_LLM_DB_USERNAME=postgres
CHATBOT_LLM_DB_PASSWORD=your_password_here
POSTGRES_DB=chatbot_llm

# Google Gemini API key
API_KEY_GEMINI=your_gemini_api_key_here

# JWT secret (Base64-encoded, mínimo 256 bits)
# Gerar com: openssl rand -base64 32
JWT_SECRET_KEY_CHATBOT_LLM=your_base64_encoded_secret_here
